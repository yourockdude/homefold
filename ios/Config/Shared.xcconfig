// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = Ryadom
PRODUCT_DISPLAY_NAME = HomeFold
PRODUCT_BUNDLE_IDENTIFIER = com.yuriyurchenko.ryadom
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 18.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2 

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = LaunchScreen/Info.plist
INFOPLIST_KEY_NSCameraUsageDescription = Камера нужна только для сканирования документов.
INFOPLIST_KEY_NSMicrophoneUsageDescription = Микрофон нужен, чтобы добавлять покупки и дела голосом.
INFOPLIST_KEY_NSSpeechRecognitionUsageDescription = Распознавание речи превращает вашу фразу в список покупок или дело. Запись не сохраняется.
INFOPLIST_KEY_NSFaceIDUsageDescription = Face ID защищает доступ к документам вашей семьи.
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/Ryadom.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/Ryadom.entitlements
