# ── Общее ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Внешний адрес API (используется в ссылках на загрузку/скачивание файлов при STORAGE_DRIVER=local). В production — https://
PUBLIC_BASE_URL=http://localhost:3000
# Базовый адрес ссылок-приглашений (universal link приложения)
INVITE_BASE_URL=https://ryadom.app/join
DATABASE_URL=postgresql://ryadom:ryadom@localhost:5432/ryadom

# ── Секреты (в production — случайные, ≥32 символов: openssl rand -base64 48) ──
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
OTP_PEPPER=dev-only-pepper
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=60
THROTTLE_LIMIT=120

# ── Почта ───────────────────────────────────────────────
# dev: Mailpit (SMTP localhost:1025, веб-интерфейс http://localhost:8025)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="рядом <no-reply@ryadom.app>"

# ── Файловое хранилище ──────────────────────────────────
# local — только для разработки; в production STORAGE_DRIVER=s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_BUCKET=ryadom-documents
S3_REGION=us-east-1
# MinIO: http://localhost:9000 и S3_FORCE_PATH_STYLE=true; для AWS S3 оставить пустым
S3_ENDPOINT=
# Адрес, который видит устройство (для MinIO в Docker: http://<IP-вашего-Mac>:9000); если пусто — берётся S3_ENDPOINT
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Подписки ────────────────────────────────────────────
# apple — боевая проверка JWS/уведомлений Apple; sandbox-mock — только dev (в production сервер не стартует)
BILLING_MODE=sandbox-mock
APPLE_BUNDLE_ID=com.yuriyurchenko.ryadom
APPLE_PRODUCT_IDS=app.ryadom.plus.monthly,app.ryadom.plus.yearly
APPLE_ROOT_CA_PATHS=certs/AppleRootCA-G3.pem
# App Store Server API (ключ из App Store Connect → Users and Access → Integrations → In-App Purchase)
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=

# ── Push (APNs). Без значений push не отправляются, всё остальное работает ──
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.yuriyurchenko.ryadom
APNS_PRIVATE_KEY=
APNS_PRODUCTION=false
