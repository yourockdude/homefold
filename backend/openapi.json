  "info": {
    "title": "рядом API",
    "description": "Backend семейного приложения «рядом». Ошибки: { \"error\": { \"code\", \"message\", \"details?\" } }.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "DeviceDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "environment": {
            "type": "string",
            "enum": [
              "sandbox",
              "production"
            ]
          }
        },
        "required": [
          "token"
        ]
      },
      "SettingsDto": {
        "type": "object",
        "properties": {
          "taskReminders": {
            "type": "boolean"
          },
          "shoppingPush": {
            "type": "boolean"
          },
          "quietHoursEnabled": {
            "type": "boolean"
          },
          "quietStart": {
            "type": "string",
            "example": "22:00"
          },
          "quietEnd": {
            "type": "string",
            "example": "08:00"
          },
          "timezone": {
            "type": "string"
          },
          "documentsProtection": {
            "type": "boolean",
            "description": "Face ID для документов; хранится для синхронизации настройки, защита действует на устройстве"
          }
        }
      },
      "RequestCodeDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "anna@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "VerifyCodeDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "123456"
          },
          "deviceName": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "code"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CreateFamilyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Смирновы"
          },
          "displayName": {
            "type": "string",
            "example": "Анна"
          }
        },
        "required": [
          "name",
          "displayName"
        ]
      },
      "UpdateFamilyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateMemberDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "member"
            ]
          },
          "color": {
            "type": "number",
            "description": "Индекс пастельного цвета аватара 0…7"
          }
        }
      },
      "AcceptDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "displayName"
        ]
      },
      "ListDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "archived"
            ]
          }
        }
      },
      "NewListDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Клиентский UUID нового списка (идемпотентность)"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ItemDto": {
        "type": "object",
        "properties": {
          "listId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Обязательно при создании"
          },
          "quantity": {
            "type": "number",
            "description": "Положительное число"
          },
          "unit": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "assigneeId": {
            "type": "object",
            "nullable": true,
            "description": "userId участника; null = «Любой»"
          },
          "note": {
            "type": "object",
            "nullable": true
          },
          "purchased": {
            "type": "boolean"
          }
        }
      },
      "OccurrenceDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Обязательно при создании"
          },
          "assigneeId": {
            "type": "object",
            "nullable": true
          },
          "date": {
            "type": "string",
            "example": "2026-10-22",
            "description": "Обязательно при создании"
          },
          "time": {
            "type": "object",
            "nullable": true,
            "example": "18:30"
          },
          "timezone": {
            "type": "string",
            "example": "Europe/Moscow"
          },
          "place": {
            "type": "object",
            "nullable": true
          },
          "note": {
            "type": "object",
            "nullable": true
          },
          "reminderMinutes": {
            "type": "object",
            "nullable": true,
            "description": "За сколько минут напомнить; по умолчанию 30; null — без напоминания"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "done"
            ]
          }
        }
      },
      "PostponeDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "time": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "ChecklistDto": {
        "type": "object",
        "properties": {
          "occurrenceId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          },
          "position": {
            "type": "number"
          }
        }
      },
      "SeriesDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "assigneeId": {
            "type": "object",
            "nullable": true
          },
          "startDate": {
            "type": "string",
            "example": "2026-10-22"
          },
          "time": {
            "type": "object",
            "nullable": true
          },
          "timezone": {
            "type": "string"
          },
          "place": {
            "type": "object",
            "nullable": true
          },
          "note": {
            "type": "object",
            "nullable": true
          },
          "repeat": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "monthly"
            ]
          },
          "reminderMinutes": {
            "type": "object",
            "nullable": true
          },
          "checklist": {
            "description": "Шаблон чек-листа для новых выполнений",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateDocumentDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "personal",
              "health",
              "home",
              "travel"
            ]
          },
          "ownerId": {
            "type": "object",
            "nullable": true,
            "description": "Чей это документ (участник). Не то же самое, что доступ."
          },
          "number": {
            "type": "object",
            "nullable": true
          },
          "expiresAt": {
            "type": "object",
            "nullable": true,
            "example": "2027-08-31"
          },
          "access": {
            "type": "string",
            "enum": [
              "author_only",
              "selected",
              "family"
            ]
          },
          "selectedUserIds": {
            "description": "Для access=selected",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string",
            "description": "Клиентский UUID"
          },
          "fileName": {
            "type": "string"
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "application/pdf",
              "image/jpeg",
              "image/png"
            ]
          },
          "sizeBytes": {
            "type": "number",
            "description": "Размер файла в байтах, до 25 МБ"
          }
        },
        "required": [
          "id",
          "fileName",
          "mimeType",
          "sizeBytes"
        ]
      },
      "UpdateDocumentDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "personal",
              "health",
              "home",
              "travel"
            ]
          },
          "ownerId": {
            "type": "object",
            "nullable": true,
            "description": "Чей это документ (участник). Не то же самое, что доступ."
          },
          "number": {
            "type": "object",
            "nullable": true
          },
          "expiresAt": {
            "type": "object",
            "nullable": true,
            "example": "2027-08-31"
          },
          "access": {
            "type": "string",
            "enum": [
              "author_only",
              "selected",
              "family"
            ]
          },
          "selectedUserIds": {
            "description": "Для access=selected",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "OperationDto": {
        "type": "object",
        "properties": {
          "opId": {
            "type": "string",
            "description": "Клиентский UUID операции — ключ идемпотентности"
          },
          "entity": {
            "type": "string",
            "enum": [
              "shoppingList",
              "shoppingItem",
              "taskSeries",
              "taskOccurrence",
              "checklistItem",
              "document"
            ]
          },
          "entityId": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "upsert",
              "delete"
            ]
          },
          "baseVersion": {
            "type": "number",
            "description": "Версия записи, на которой основана правка"
          },
          "payload": {
            "type": "object",
            "description": "Поля сущности (те же, что в REST PUT)"
          }
        },
        "required": [
          "opId",
          "entity",
          "entityId",
          "type"
        ]
      },
      "PushDto": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OperationDto"
            }
          }
        },
        "required": [
          "operations"
        ]
      },
      "VerifyDto": {
        "type": "object",
        "properties": {
          "signedTransaction": {
            "type": "string",
            "description": "JWS подписанной транзакции StoreKit 2 (Transaction.jsonRepresentation)"
          }
        },
        "required": [
          "signedTransaction"
        ]
      },
      "RestoreDto": {
        "type": "object",
        "properties": {
          "signedTransactions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "signedTransactions"
        ]
      },
      "AppleNotificationDto": {
        "type": "object",
        "properties": {
          "signedPayload": {
            "type": "string"
          }
        },
        "required": [
          "signedPayload"
        ]
      },
      "MockPurchaseDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "days": {
            "type": "number"
          }
        }
      },
      "MockExpireDto": {
        "type": "object",
        "properties": {
          "autoRenewOff": {
            "type": "boolean",
            "description": "true — только отключить автопродление"
          }
        }
      }
    }
  }
}